// Password Reset on Privileged Account
// Tactic: Persistence | Technique: T1098 - Account Manipulation
// Severity: Medium | Cadence: every 5 min
// Entity mapping: Account(FullName) -> Target, Account(FullName) -> Actor
// Limitation: privileged list is reconstructed from audit history, so it misses
// accounts elevated before logging was enabled. Use a watchlist in production.

let privilegedAccounts = AuditLogs
| where OperationName has "Add member to role"
| extend Target = tostring(TargetResources[0].userPrincipalName)
| distinct Target;
AuditLogs
| where OperationName has_any ("Reset password", "Update PasswordProfile", "Change user password")
| extend Target = tostring(TargetResources[0].userPrincipalName)
| extend Actor = tostring(InitiatedBy.user.userPrincipalName)
| where Target in (privilegedAccounts)
| project TimeGenerated, OperationName, Actor, Target, Result
